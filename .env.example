# ---- Avis / AARP ----
# Your AARP Avis Worldwide Discount (AWD) number. Find it in your AARP member
# benefits ("Avis" -> "AWD code"). This is injected into every search.
AWD_CODE=

# Override which engine reads prices: mock | avis  (start with mock to test)
PROVIDER=mock

# Optional residential/rotating proxy for the live scraper (recommended on a
# cloud server, since datacenter IPs get flagged faster). e.g. http://user:pass@host:port
PROXY_URL=

# Override which channel sends alerts: console | pushover | imessage | telegram
NOTIFIER=console

# ---- Pushover (recommended for a cloud server) ----
# Create app at https://pushover.net -> you get a user key + app token.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# ---- iMessage (requires a Mac that stays on) ----
# If this app runs ON the Mac, leave RELAY blank (it uses osascript directly).
# If the app runs on a cloud server, point this at the tiny relay you run on
# your Mac (see README -> "iMessage via a Mac relay").
IMESSAGE_TO=          # phone number or Apple ID email to message
IMESSAGE_RELAY_URL=   # e.g. http://your-mac-tailscale-ip:8787/send
IMESSAGE_RELAY_SECRET=

# ---- Telegram (free alternative) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
